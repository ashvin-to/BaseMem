#!/usr/bin/env bash
# SessionStart hook for BaseMem memory protocol
# Injects BaseMem bootstrap context at session start

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

skill_content=$(cat "${PLUGIN_ROOT}/skills/using-basemem/SKILL.md" 2>&1 || echo "Error reading using-basemem skill")

export PATH="$PATH:$HOME/.local/bin"
PROJECT_NAME="$(basename "$PWD")"
ctx=$(mem agent-context --topic "$PROJECT_NAME" 2>/dev/null || echo "")

python3 -c '
import json, sys, os
skill = sys.argv[1]
ctx = sys.argv[2]
has_data = ctx.strip() and "No stored context found" not in ctx and "Error automatically fetching" not in ctx
if has_data:
    text = f"<EXTREMELY_IMPORTANT>\nYou have BaseMem memory available.\n\nProject memory context is already injected above — do not call getContext or list_planets at session start. Only use getContext mid-session if you need a refresh or switch topics.\n\n**Memory data:**\n{ctx}\n\n**Below is the full content of your basemem skill.**\n\n{skill}\n</EXTREMELY_IMPORTANT>"
else:
    text = f"<EXTREMELY_IMPORTANT>\nYou have BaseMem memory available.\n\nNo context was automatically fetched. Call getContext at session start with your current project topic to retrieve available memory. Do not call list_planets.\n\n**Below is the full content of your basemem skill.**\n\n{skill}\n</EXTREMELY_IMPORTANT>"

output = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}, "additionalContext": text}
if os.environ.get("CURSOR_PLUGIN_ROOT"):
    output = {"additional_context": text}
elif os.environ.get("COPILOT_CLI"):
    output = {"additionalContext": text}

print(json.dumps(output))
' "$skill_content" "$ctx"

exit 0
