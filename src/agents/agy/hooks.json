{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${AGY_PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/basemem}/hooks/session-start.js\"",
            "statusMessage": "Loading BaseMem memory context",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${AGY_PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/basemem}/hooks/prompt-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
