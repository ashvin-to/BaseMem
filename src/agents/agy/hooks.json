{
  "basemem-hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"${extensionPath}/hooks/session-start.js\""
      },
      {
        "type": "command",
        "command": "node \"${extensionPath}/hooks/prompt-tracker.js\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"${extensionPath}/hooks/session-stop.js\""
      }
    ]
  }
}
