{
  "basemem-startup": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"${extensionPath}/hooks/session-start.js\""
      }
    ]
  },
  "basemem-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "node \"${extensionPath}/hooks/session-stop.js\""
      }
    ]
  }
}
