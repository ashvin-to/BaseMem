{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${DEVIN_PLUGIN_ROOT}/hooks/session-start.js\"",
            "statusMessage": "Loading BaseMem memory context",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${DEVIN_PLUGIN_ROOT}/hooks/prompt-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${DEVIN_PLUGIN_ROOT}/hooks/session-stop.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
